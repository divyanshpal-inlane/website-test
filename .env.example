# Copy to .env and fill in. Never commit .env.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_CRATIO_WEBHOOK_URL=

# Funnel instrumentation kill-switch. Set to "off" to disable every outbound
# funnel event call (forms still work via the original delivery path).
# Baked at build time - redeploy to change.
VITE_FUNNEL_TRACKING=on
